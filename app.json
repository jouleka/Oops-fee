{
  "expo": {
    "name": "oops-fee",
    "slug": "oops-fee",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "oopsfee",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.oopsfee.app",
      "appleTeamId": "VNF5P4YVBN",
      "associatedDomains": [
        "applinks:oopsfee.app"
      ],
      "infoPlist": {
        "NSMicrophoneUsageDescription": "OopsFee needs mic access to record your promise. (For evidence.)"
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.oopsfee.app"
        ],
        "com.apple.developer.applesignin": [
          "Default"
        ],
        "com.apple.developer.associated-domains": [
          "applinks:oopsfee.app"
        ]
      },
      "usesAppleSignIn": true
    },
    "android": {
      "permissions": [
        "RECORD_AUDIO",
        "RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png",
        "backgroundColor": "#070B16"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.oopsfee.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "oopsfee.app",
              "pathPrefix": "/s/"
            },
            {
              "scheme": "https",
              "host": "oopsfee.app",
              "pathPrefix": "/invite/"
            },
            {
              "scheme": "https",
              "host": "oopsfee.app",
              "pathPrefix": "/claim/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "oopsfee"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#070B16"
        }
      ],
      "@bacons/apple-targets",
      "./plugins/withWidgetKitModule",
      "./plugins/withAndroidWidget",
      "expo-secure-store",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.oopsfee.app",
          "urlScheme": "oopsfee",
          "enableGooglePay": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "bundleIdentifier": "com.oopsfee.app.widget",
                  "targetName": "OopsFeeWidget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.oopsfee.app"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "c74989cd-da8b-4327-865c-d6a7977e8c00"
      }
    },
    "owner": "jurgenleka"
  }
}
